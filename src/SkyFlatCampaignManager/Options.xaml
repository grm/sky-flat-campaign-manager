<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.SkyFlatCampaignManager"
    x:Class="NINA.Plugin.SkyFlatCampaignManager.Options">

    <!--
      NINA restyles CheckBox as a toggle switch and does not render CheckBox.Content.
      Put labels in a TextBlock beside the CheckBox (standard NINA plugin Options pattern).
    -->
    <DataTemplate x:Key="Sky Flat Campaign Manager_Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="8" Orientation="Vertical" MinWidth="720">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding DisplayName}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding PluginVersion, StringFormat=Version {0}}" Margin="0,0,0,12" Opacity="0.7"/>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Plugin enabled" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding PluginEnabled}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Detailed logging" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding DetailedLogging}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dry-run (no dangerous hardware commands / no file saves)" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding DryRun}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-start new campaign when expired" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoStartExpiredCampaign}" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Campaign name" Margin="0,16,0,2"/>
                <TextBox Text="{Binding CampaignName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Validity (days)" Margin="0,12,0,2"/>
                <TextBox Text="{Binding ValidityDays, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="State directory" Margin="0,12,0,2"/>
                <TextBox Text="{Binding StateDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                           Text="{Binding EffectiveStateDirectory, StringFormat=Effective path: {0}}"/>

                <TextBlock Text="Default target flats / filter" Margin="0,12,0,2"/>
                <TextBox Text="{Binding DefaultTargetCount, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Default target histogram level (% of full scale)" Margin="0,12,0,2"/>
                <TextBox Text="{Binding DefaultTargetHistogramPercent, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Default tolerance (% of target, NINA-style)" Margin="0,12,0,2"/>
                <TextBox Text="{Binding DefaultTargetTolerancePercent, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Sun safety separation (degrees)" Margin="0,12,0,2"/>
                <TextBox Text="{Binding SunSafetySeparationDegrees, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,20,0,6" Text="Per-filter campaign settings"/>
                <TextBlock Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Gain/Offset = -1 keeps the camera current value. New filters are seeded from Flat Wizard settings when available. Changes save automatically."/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Reload from filter wheel" Command="{Binding ReloadFilterConfigCommand}" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="Save now" Command="{Binding SaveFilterConfigCommand}" Padding="10,4" Margin="0,0,8,0"/>
                    <Button Content="Apply global defaults to target/count" Command="{Binding ApplyDefaultsToFiltersCommand}" Padding="10,4"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding FilterConfigs}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MaxHeight="360"
                          MinHeight="120"
                          AlternatingRowBackground="#22FFFFFF">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Filter" Binding="{Binding FilterName}" IsReadOnly="True" Width="90"/>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                        <DataGridTextColumn Header="Count" Binding="{Binding TargetCount, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Min OK" Binding="{Binding MinimumAcceptableCount, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Target %" Binding="{Binding TargetHistogramPercent, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                        <DataGridTextColumn Header="Tol % of target" Binding="{Binding TargetTolerancePercent, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="≈ADU @16-bit" Binding="{Binding TargetAduPreview, Mode=OneWay}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Gain" Binding="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="BinX" Binding="{Binding BinningX, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="BinY" Binding="{Binding BinningY, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="Min s" Binding="{Binding MinExposureSeconds, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Max s" Binding="{Binding MaxExposureSeconds, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Eve#" Binding="{Binding EveningOrder, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                        <DataGridTextColumn Header="Morn#" Binding="{Binding MorningOrder, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Prio" Binding="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,6,0,0" Opacity="0.75" Text="{Binding FilterConfigStatus}" TextWrapping="Wrap"/>

                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.8"
                           Text="Campaign key / mode / wait / SQM are set on the Advanced Sequencer instructions. SQM is optional via weather SkyQuality."/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
